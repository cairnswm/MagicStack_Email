# List Templates
# Description: Returns all email templates for the tenant (id, code, name, isActive).

@baseUrl = http://localhost:{{$dotenv PORT}}
@tenantId = {{$dotenv TENANT_ID}}
@apiKey = your-api-key
@hostname = localhost

### Get all templates
GET {{baseUrl}}/template
X-Tenant-ID: {{tenantId}}
X-APIKEY: {{apiKey}}
X-Hostname: {{hostname}}
Accept: application/json
