# Get all properties for a tenant
# Description: Returns all properties for the tenant. Tenant id may be provided via `X-Tenant-ID` header or `?tenantId=` query.

@baseUrl = http://localhost:{{$dotenv PORT}}
@tenantId = {{$dotenv TENANT_ID}}
@bearerToken = {{$dotenv TEST_BEARER_TOKEN}}

# Alternative using header
### Get all properties (header)
GET {{baseUrl}}/tenant/property
X-Tenant-ID: {{tenantId}}
Accept: application/json
Authorization: Bearer {{bearerToken}}
